{
  "name": "grammar",
  "version": "1.0.0",
  "description": "Rule-based grammatical analysis engine",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "analyze": "node --experimental-strip-types src/cli.ts",
    "build": "esbuild src/browser.ts --bundle --format=iife --global-name=GrammarEngine --loader:.gram=text --outfile=dist/engine.js",
    "serve": "node --experimental-strip-types scripts/serve.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BolvarsDad/grammar.git"
  },
  "keywords": [],
