# Grammar rules (%include'd from en.gram)

S -> NP VP
    <NP vagr> = <VP vagr>   ! "subject-verb agreement (number/person)"  fix: agree(V) | agree(N)
    # Past "be" agrees on a different partition than `vagr` (see clitics.gram),
    # so it constrains the subject's num/pers directly. Every other verb leaves
    # <VP num>/<VP pers> unset, which makes these two equations vacuous.
    <NP num>  = <VP num>    ! "subject-verb agreement (number/person)"  fix: agree(Cop) | agree(Aux) | agree(N)
    <NP pers> = <VP pers>   ! "subject-verb agreement (number/person)"  fix: agree(Cop) | agree(Aux) | agree(N)
    <NP case> = nom         ! "the subject must be a nominative pronoun"  fix: agree(Pron, case=nom)
    <VP vform> = fin        # the head of a main clause must be a finite verb

# Clause coordination: "the dog barks and the cat barks". Each conjunct is an
# independent S, so no agreement crosses the conjunction.
S -> S Conj S

NP -> Det N
    <Det num> = <N num>         ! "determiner-noun number agreement"  fix: swap(Det) | agree(N)
    <N initial> = <Det initial> ! "article form: use 'a' before a consonant, 'an' before a vowel"  fix: swap(Det)
    <NP num>  = <N num>
    <NP pers> = <N pers>
    <NP vagr> = <N vagr>

NP -> N
    <N num>   = pl          ! "singular count nouns need a determiner (e.g. 'a dog', 'the dog')"  fix: insert(Det) | agree(N)
    <NP num>  = <N num>
    <NP pers> = <N pers>
    <NP vagr> = <N vagr>

# Attributive adjectives. The article agrees with the adjective's initial sound
# ("a big dog", "an old dog"), so the article check moves onto the AdjP; the
# adjective is otherwise transparent to number/person/agreement.
NP -> Det AdjP N
    <Det num> = <N num>            ! "determiner-noun number agreement"  fix: swap(Det) | agree(N)
    <AdjP initial> = <Det initial> ! "article form: use 'a' before a consonant, 'an' before a vowel"  fix: swap(Det)
    <NP num>  = <N num>
    <NP pers> = <N pers>
    <NP vagr> = <N vagr>

NP -> AdjP N
    <N num>   = pl          ! "singular count nouns need a determiner (e.g. 'a dog', 'the dog')"  fix: insert(Det) | agree(N)
    <NP num>  = <N num>
    <NP pers> = <N pers>
    <NP vagr> = <N vagr>

# An adjective phrase is an optional degree word ("very") followed by one or more
# adjectives ("big old"). Its `initial` -- what the article agrees with -- is its
# leftmost word. The trailing adjectives are collected by AdjList, a separate
# symbol so the recursion never collides with AdjP's own head, which would
# otherwise force the phrase to inherit the last adjective's initial rather than
# the first.
AdjP -> Adj
    <AdjP initial> = <Adj initial>
AdjP -> Deg Adj
    <AdjP initial> = <Deg initial>
    <Adj comp> = <Deg comp>  ! "use more/most with a long adjective, -er/-est with a short one"  fix: swap(Deg)
AdjP -> Adj AdjList
    <AdjP initial> = <Adj initial>
AdjP -> Deg Adj AdjList
    <AdjP initial> = <Deg initial>
    <Adj comp> = <Deg comp>  ! "use more/most with a long adjective, -er/-est with a short one"  fix: swap(Deg)

AdjList -> Adj
AdjList -> Adj AdjList

NP -> Pron
    <NP num>  = <Pron num>
    <NP pers> = <Pron pers>
    <NP case> = <Pron case>
    <NP vagr> = <Pron vagr>

# Coordinated noun phrases. This rule has two NP daughters and an NP mother --
# three same-category constituents -- which only works because constituent
# addressing is positional: bare <NP ...> is the mother, and the daughters are
# named by aliases (l, r). The conjunction drives agreement: "and" makes the
# whole phrase plural (<and num>=pl, vagr=n3sg); "or" carries no num/vagr,
# leaving the mother's open (so "or" agrees with either a singular or plural
# verb). Each conjunct shares the coordinate's role-case, so "he and I" is a
# valid subject but "me and him" is not (and "him and me" is a valid object).
NP -> l:NP Conj r:NP
    <NP num>  = <Conj num>
    <NP vagr> = <Conj vagr>
    <l case>  = <NP case>
    <r case>  = <NP case>

VP -> V
    <VP vagr> = <V vagr>
    <VP vform> = <V vform>

VP -> V NP
    <VP vagr> = <V vagr>
    <VP vform> = <V vform>
    <NP case> = acc         ! "the object must be an accusative pronoun"  fix: agree(Pron, case=acc)
# A Det-N NP sets no `case`, so it stays open and fills subject or object
# position freely; only pronouns can clash on case.


# Copula predication and its negation, of a noun phrase (he's a dog) or an
# adjective (the dog is big, he isn't happy). Agreement is carried by the copula;
# the predicate adjective is invariant.
VP -> Cop NP
    <VP vagr> = <Cop vagr>
    <VP num>  = <Cop num>
    <VP pers> = <Cop pers>
    <VP vform> = fin
VP -> Cop Neg NP
    <VP vagr> = <Cop vagr>
    <VP num>  = <Cop num>
    <VP pers> = <Cop pers>
    <VP vform> = fin
VP -> Cop AdjP
    <VP vagr> = <Cop vagr>
    <VP num>  = <Cop num>
    <VP pers> = <Cop pers>
    <VP vform> = fin
VP -> Cop Neg AdjP
    <VP vagr> = <Cop vagr>
    <VP num>  = <Cop num>
    <VP pers> = <Cop pers>
    <VP vform> = fin

# Auxiliaries take a verb phrase whose form they select (the modal/do want the
# base form, perfect "have" a past participle, progressive "be" an -ing form):
# I'll bark, I've liked the dog, he is barking, I don't bark. The auxiliary is
# the finite head, so an auxiliary phrase is a finite VP (VP -> AuxP) and
# satisfies S -> NP VP; agreement lives on the auxiliary.
AuxP -> Aux VP
    <AuxP vagr> = <Aux vagr>
    <AuxP num>  = <Aux num>
    <AuxP pers> = <Aux pers>
    <AuxP vform> = fin
    <VP vform> = <Aux req>  ! "wrong verb form after the auxiliary"  fix: agree(V)
AuxP -> Aux Neg VP
    <AuxP vagr> = <Aux vagr>
    <AuxP num>  = <Aux num>
    <AuxP pers> = <Aux pers>
    <AuxP vform> = fin
    <VP vform> = <Aux req>  ! "wrong verb form after the auxiliary"  fix: agree(V)
VP -> AuxP
    <VP vagr> = <AuxP vagr>
    <VP num>  = <AuxP num>
    <VP pers> = <AuxP pers>
    <VP vform> = <AuxP vform>


PP -> P NP
    <NP case> = acc         ! "the object of a preposition must be accusative"  fix: agree(Pron, case=acc)

# The mother shares its symbol with the head daughter, so apply_equations' env
# (keyed by category symbol) makes the mother inherit the head daughter's feature
# structure automatically -- correct head percolation with no equations needed.
NP -> NP PP
VP -> VP PP

# Manner adverbs modify a verb phrase, before or after it ("the dog barks
# loudly", "the dog quickly barks"). Like VP -> VP PP, the mother shares the head
# VP's features by default, so the adverb is transparent to subject-verb
# agreement and verb form.
VP -> VP Adv
VP -> Adv VP


%mal S -> V NP
    *ERR "word order: English clauses are subject-verb-object; the verb appears before its subject"
    # fix suggestions are derived automatically: every reordering of the matched
    # constituents that parses clean ("barks the dog" -> "the dog barks")
