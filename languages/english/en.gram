# English grammar -- manifest.
#
# This file wires together the pieces with %include / %import. The actual
# content lives in the sub-files so each part (closed-class lexicon, open-class
# morphology, bulk noun lexicon, syntax) can grow independently.
#
# Syntax
# ------
#   lexicon entry : form : CAT  <path>=value ...
#   rule          : LHS -> RHS RHS ...
#                   <path> = <path>     # unify two constituents' substructures
#                   <path> = value      # constrain a feature to an atomic value
#   diagnostic    : append  ! "message"  fix: primitive | primitive   to an equation
#                   (primitives: agree(<cat>[,<feat>=<val>]) | swap(<cat>) | insert(<cat>));
#                   reported (with the constituents in the equation highlighted)
#                   when relaxing exactly that constraint rescues the parse.
#   mal-rule      : %mal LHS -> RHS ...   with *ERR "message" (fixes are derived
#                   automatically: constituent reorderings that parse clean)
#   declaration   : %feature <name> : v1 | v2 | ...   (or `: *` for an open feature)
#   engine config : %start <Sym>   %tokenizer <name>   %clitic <suffix>...
#   file directive: %include <file.gram>   %import <file.tsv>
#
# Feature values are atomic for this first slice (no disjunction/sets).
# An unset feature unifies with anything (underspecification).
#
# Features:
#   num  = sg | pl          number
#   pers = 1 | 2 | 3        person
#   case = nom | acc        pronoun case (subject vs object)
#   vagr = 3sg | n3sg       subject-verb agreement contrast (see note below)
#   comp = suffix | periph  how the adjective compares (-er/-est vs more/most)
#
# Note on `vagr`: English present-tense agreement only contrasts 3rd-person-
# singular ("barks") with everything else ("bark"). "Everything else" is
# disjunctive (num=pl OR pers!=3), which atomic unification can't state, so each
# noun/pronoun carries a precomputed atomic `vagr` and verbs require a subject
# `vagr`. Agreement is then plain equality. Revisit when a disjunctive value
# type exists.
#
# Note on `comp`: English compares short adjectives with -er/-est ("bigger") and
# longer ones with more/most ("more curious"), and the two are not interchange-
# able ("*more big", "*curiouser"). The suffixal ones are a morphology paradigm
# (Adj-reg), so the split is lexical: every adjective carries `comp`, and
# more/most demand <comp>=periph. Suffixal adjectives then can't follow them.

# Feature declarations. Declaring features turns on load-time validation: any
# atomic value that isn't listed here (a typo like <num>=sgular) fails at load
# instead of silently never unifying. `lemma` is open (any value).
%feature num     : sg | pl
%feature pers    : 1 | 2 | 3
%feature case    : nom | acc
%feature vagr    : 3sg | n3sg
%feature initial : cons | vowel
%feature tense   : pres | past | bare
%feature vform   : bare | fin | pastp | prp
%feature req     : bare | pastp | prp
%feature degree  : pos | comp | sup
%feature comp    : suffix | periph
%feature lemma   : *

# Engine configuration. English parses from S, splits on whitespace, and peels off
# the contraction clitics so "don't"/"I'll" tokenize as do+n't / I+'ll.
%start S
%tokenizer whitespace
%clitic n't 're 've 'll 'm 'd 's

%include closed.gram
%include clitics.gram
%include adjectives.gram
%include adverbs.gram
%include morph.gram
%import  lexicon.tsv
%include syntax.gram
