  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BolvarsDad/grammar/issues"
  },
  "homepage": "https://github.com/BolvarsDad/grammar#readme",
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
