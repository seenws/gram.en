# Open-class morphology (%include'd from en.gram)
#
# Character classes for rewrite-rule contexts (used by %rule).
%class Vowel : a | e | i | o | u
%class Cons  : b | c | d | f | g | h | j | k | l | m | n | p | q | r | s | t | v | w | x | y | z
#
# N-reg covers regular consonant-initial nouns (dog/dogs, cat/cats) and V-reg
# covers regular present-tense verbs in their bare and 3sg forms (bark/barks,
# like/likes). Regular open-class noun and verb stems -- including the dual N+V
# `bark` -- now live in lexicon.tsv, pulled in via `%import lexicon.tsv` from
# en.gram. The roots below are the ones that must stay next to a paradigm here:
# an irregular (`child`), a stem the cascade can't fully inflect yet (`try`), and
# the regular adjectives (a distinct open class, kept out of lexicon.tsv).
#
# `try` is a regular V-reg verb but stays out of the curated lexicon: its 3sg
# "tries" needs a y->ies rule the boundary-free cascade lacks (it yields "trys"
# today). See the Future note in lexicon.tsv.
%lex Root
    try   : V-reg            <lemma>=try
    child : N-irreg-children <lemma>=child <initial>=cons
    # Regular adjectives: comparative/superlative are productive (see Adj-reg).
    # `initial` (for article agreement) rides on the root and is unchanged by the
    # -er/-est suffix, so "a bigger dog" / "an older dog" still agree correctly.
    big   : Adj-reg          <lemma>=big   <initial>=cons
    small : Adj-reg          <lemma>=small <initial>=cons
    tall  : Adj-reg          <lemma>=tall  <initial>=cons
    red   : Adj-reg          <lemma>=red   <initial>=cons
    happy : Adj-reg          <lemma>=happy <initial>=cons
    large : Adj-reg          <lemma>=large <initial>=cons
    old   : Adj-reg          <lemma>=old   <initial>=vowel
    angry : Adj-reg          <lemma>=angry <initial>=vowel

%lex N-reg : N
    +N+Sg :    <num>=sg <pers>=3 <vagr>=3sg
    +N+Pl : s  <num>=pl <pers>=3 <vagr>=n3sg

%lex V-reg : V
    # English verb forms are syncretic: one surface often spells several forms.
    # `vform` names the form so auxiliaries can select their complement and the
    # main clause can require a finite head; the parser picks the analysis that
    # fits. "bark" is base (after a modal/do) or non-3sg present; "barked" is
    # finite past or past participle; "barking" is the present participle.
    +V+Inf       :     <vform>=bare                          # bark   (base form)
    +V+Pres+Bare :     <vform>=fin <tense>=pres <vagr>=n3sg  # bark   (I/you/they bark)
    +V+Pres+3Sg  : s   <vform>=fin <tense>=pres <vagr>=3sg   # barks
    +V+Past      : ed  <vform>=fin <tense>=past              # barked (finite past; no agreement)
    +V+PastP     : ed  <vform>=pastp <tense>=past            # barked (past participle, after have)
    +V+PrP       : ing <vform>=prp                           # barking (after be)

%lex Adj-reg : Adj
    +Adj      :     <degree>=pos   <comp>=suffix   # big
    +Adj+Comp : er  <degree>=comp  <comp>=suffix   # bigger
    +Adj+Sup  : est <degree>=sup   <comp>=suffix   # biggest

# Spelling rules, applied in generation order (underlying -> surface) and run
# backwards by morph_analyze to recover the underlying form during analysis.
# The lexicon filters out any overgeneration these produce. One rule set serves
# every vowel-initial suffix (-ed, -ing, -er, -est):
#   - drop a stem-final silent e:  chase+ed -> chased, chase+ing -> chasing,
#     like+ed -> liked, large+er -> larger, large+est -> largest
#   - y -> i before an e-suffix:   try+ed -> tried, happy+er -> happier
#     (but "trying", so not before -ing)
#   - double a final consonant of a C-V-C stem:  big+er -> bigger, red+er -> redder
#     (the Vowel _ Vowel context fires for "biger" but not "older"/"smaller")
#
# Future: the silent-e rule's right context is linguistically wide (any vowel,
# not specifically a suffix). It's safe here only because the lexicon and
# morph_analyze discard the over-generation. Make it boundary-sensitive --
# e.g. `e:0 => _ ^ Vowel` -- once a morpheme-boundary marker is on the tape
# (postponed: a boundary needs the composed lexical transducer, not the
# sequential cascade, to stay tractable).
%rule e:0 => Cons _ Vowel
%rule y:i => Cons _ e
%rule g:gg => Vowel _ Vowel
%rule d:dd => Vowel _ Vowel

# The second +N+Pl entry recognises the anticipated wrong plural "*childs"
# (the FST emits "child+N+Pl" for both surfaces; morph_analyze narrows by
# the actual surface and copies *ERR/*FIX onto the wrong-surface analysis).
%lex N-irreg-children : N
    +N+Sg :     <num>=sg <pers>=3 <vagr>=3sg
    +N+Pl : ren <num>=pl <pers>=3 <vagr>=n3sg
    +N+Pl : s   <num>=pl <pers>=3 <vagr>=n3sg  *ERR "irregular plural: 'children', not '*childs'"  *FIX children
