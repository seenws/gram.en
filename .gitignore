# Dependencies
node_modules/

# UD treebanks used only for dev-time validation (scripts/ud-check.ts). Downloaded
# on demand; never shipped. Each treebank has its own license -- kept out of the repo.
tools/ud/

# Generated by scripts/flatten.ts (each language's manifest with %include/%import
# resolved): languages/english/en.flat.gram, languages/swedish/sv.flat.gram, ...
languages/*/*.flat.gram

# Build output.
# NOTE: index.html loads dist/engine.js at runtime. If you deploy the static
# site straight from the repo (e.g. GitHub Pages) with no build step, either
# un-ignore dist/ or build it in CI.
dist/

# LaTeX build artifacts (the notes/ .tex source and rendered .pdf stay tracked)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# OS / editor cruft
.DS_Store
*.swp
*~
